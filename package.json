{
  "name": "taskflow-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "TaskFlow: a collaborative task and project management frontend built with React and Vite, prepared for a Node, Express, and MongoDB backend.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "mern",
    "react",
    "vite",
    "task-management",
    "project-management",
    "productivity",
    "frontend"
  ],
  "author": "TaskFlow Team",
  "license": "Apache-2.0"
}
