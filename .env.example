# TaskFlow frontend environment variables
# Copy this file to .env and adjust values for your machine or deployment.
# Never commit a real .env file or secrets. Everything prefixed with VITE_
# is bundled into client code and is publicly readable.

# Base URL for the backend REST API (Node.js + Express).
# Local example:  http://localhost:5000/api
# Deployed example: https://api.example.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Optional. Origin used by the Vite dev-server proxy for /api requests.
# Defaults to VITE_API_BASE_URL with a trailing /api removed.
# VITE_DEV_PROXY_TARGET=http://localhost:5000
