# TaskFlow Frontend Environment Variables
# Copy this file to .env and fill in your backend URL
# Never commit a real .env file with secrets.

# Base URL for the backend REST API (Node.js + Express)
# Example local: http://localhost:5000/api
# Example deployed: https://api.taskflow.example.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Optional: app metadata (safe to expose)
VITE_APP_NAME=TaskFlow
VITE_APP_ENV=development
